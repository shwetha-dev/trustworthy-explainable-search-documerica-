def determine_checkability(row):

    field = row["claim_field"]

    if field == "location":
        available = bool(row["city"] or row["state"])

    elif field == "date":
        available = bool(row["date_taken"])

    elif field == "context":
        available = bool(
            row["keywords"] or
            row["exhibit_description"]
        )

    elif field == "visual":
        # Archival metadata generally cannot directly verify
        # purely visual claims.
        available = False

    else:
        available = False

    return "checkable" if available else "not_metadata_checkable"


