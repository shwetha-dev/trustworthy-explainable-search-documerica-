        "epa", "military", "school", "church",
        "hospital", "factory", "industrial",
        "event", "occupation", "photographer",
        "historically", "during", "period"
    ]

    if any(keyword in text for keyword in date_keywords):
        return "date"

    elif any(keyword in text for keyword in location_keywords):
        return "location"

    elif any(keyword in text for keyword in context_keywords):
