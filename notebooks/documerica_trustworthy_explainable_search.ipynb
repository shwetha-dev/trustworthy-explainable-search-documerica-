# Cell 26 — Calculate claim-level NLI consistency

claim_nli_records = []

# Create a lookup from sentence index to claim ID
sentence_to_claim = dict(
    zip(
        claim_level_df["sentence_index"],
        claim_level_df["claim_id"]
    )
)

for _, row in nli_results_df.iterrows():

    # Find the original sentence indices
    source_matches = sentences_df[
        (sentences_df["image_name"] == row["image_name"]) &
        (sentences_df["explanation_index"] == row["source_explanation"]) &
        (sentences_df["sentence_number"] == row["source_sentence_number"])
    ]

    target_matches = sentences_df[
        (sentences_df["image_name"] == row["image_name"]) &
        (sentences_df["explanation_index"] == row["target_explanation"]) &
        (sentences_df["sentence_number"] == row["target_sentence_number"])
    ]

    if len(source_matches) == 0 or len(target_matches) == 0:
        continue

    source_idx = source_matches.index[0]
    target_idx = target_matches.index[0]

    source_claim = sentence_to_claim.get(source_idx)
    target_claim = sentence_to_claim.get(target_idx)

    if source_claim is None or target_claim is None:
        continue

    claim_nli_records.append({
        "image_name": row["image_name"],
        "source_claim_id": source_claim,
        "target_claim_id": target_claim,
        "source_sentence": row["source_sentence"],
        "target_sentence": row["target_sentence"],
        "similarity": row["similarity"],
        "nli_label": row["nli_label"],
        "nli_score": row["nli_score"]
    })

claim_nli_df = pd.DataFrame(claim_nli_records)

print("✓ Claim-level NLI evidence created")
print("NLI records:", len(claim_nli_df))
print("Unique source claims:", claim_nli_df["source_claim_id"].nunique())
print("Unique target claims:", claim_nli_df["target_claim_id"].nunique())

print("\nNLI label distribution:")
print(claim_nli_df["nli_label"].value_counts())

display(claim_nli_df.head(10))


# Cell 27 — Claim-level NLI consistency

claim_consistency_records = []

# Each claim can appear in multiple NLI comparisons.
# We combine evidence from both source and target sides.

all_claim_ids = set(
    claim_level_df["claim_id"].unique()
)

for claim_id in all_claim_ids:

    # NLI comparisons where this claim is the source
    source_evidence = claim_nli_df[
        claim_nli_df["source_claim_id"] == claim_id
    ]

    # NLI comparisons where this claim is the target
    target_evidence = claim_nli_df[
        claim_nli_df["target_claim_id"] == claim_id
    ]

    evidence = pd.concat(
        [source_evidence, target_evidence],
        ignore_index=True
    )

    entailment_count = (
        evidence["nli_label"] == "entailment"
    ).sum()

    contradiction_count = (
        evidence["nli_label"] == "contradiction"
    ).sum()

    neutral_count = (
        evidence["nli_label"] == "neutral"
    ).sum()

    denominator = entailment_count + contradiction_count

    if denominator > 0:
        consistency = entailment_count / denominator
    else:
        consistency = np.nan

    image_name = claim_level_df.loc[
        claim_level_df["claim_id"] == claim_id,
        "image_name"
    ].iloc[0]

    claim_consistency_records.append({
        "claim_id": claim_id,
        "image_name": image_name,
        "nli_comparisons": len(evidence),
        "entailment_count": entailment_count,
        "contradiction_count": contradiction_count,
        "neutral_count": neutral_count,
        "consistency_score": consistency,
        "consistency_percent": (
            consistency * 100
            if not np.isnan(consistency)
            else np.nan
        )
    })

claim_consistency_df = pd.DataFrame(
    claim_consistency_records
)

print("✓ Claim-level consistency calculated")

