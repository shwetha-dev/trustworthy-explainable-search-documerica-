# Cell 18 — Create image-level NLI summary

def calculate_consistency(group):
    entailment = (group["nli_label"] == "entailment").sum()
    contradiction = (group["nli_label"] == "contradiction").sum()
    
    denominator = entailment + contradiction
    
    if denominator == 0:
        consistency = None
    else:
        consistency = entailment / denominator
    
    return pd.Series({
        "nli_pairs": len(group),
        "entailment_count": entailment,
        "contradiction_count": contradiction,
        "neutral_count": (group["nli_label"] == "neutral").sum(),
        "contradiction_rate": contradiction / len(group),
        "consistency_score": consistency
    })


image_nli_summary = (
    nli_results_df
    .groupby("image_name")
    .apply(calculate_consistency, include_groups=False)
    .reset_index()
)

# Convert consistency to percentage
image_nli_summary["consistency_percent"] = (
    image_nli_summary["consistency_score"] * 100
)

# Save
