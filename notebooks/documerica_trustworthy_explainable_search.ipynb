# Cell 40 — Assign metadata support categories

import re
import pandas as pd

def clean_text(value):
    if pd.isna(value):
        return ""
    return str(value).strip().lower()


def assess_metadata(row):

    claim = clean_text(row["claim_text"])
    field = clean_text(row["claim_field"])

    city = clean_text(row["city"])
    state = clean_text(row["state"])
    date = clean_text(row["date_taken"])
    keywords = clean_text(row["keywords"])
    description = clean_text(row["exhibit_description"])
    byline = clean_text(row["byline"])

    # --------------------------------------------------
    # 1. Visual claims
    # --------------------------------------------------
    # Archival metadata cannot normally verify
    # purely visual observations.
    if field == "visual":
        return "not_metadata_checkable"

    # --------------------------------------------------
    # 2. Location claims
    # --------------------------------------------------
    if field == "location":

        if not city and not state:
            return "not_metadata_checkable"

        location_values = [x for x in [city, state] if x]

        if any(value in claim for value in location_values):
            return "potentially_supported"

        return "unverifiable"

    # --------------------------------------------------
    # 3. Date claims
    # --------------------------------------------------
    if field == "date":

        if not date:
            return "not_metadata_checkable"

        claim_years = set(
            re.findall(r"\b(?:18|19|20)\d{2}\b", claim)
        )

        metadata_years = set(
            re.findall(r"\b(?:18|19|20)\d{2}\b", date)
        )

        if not claim_years or not metadata_years:
            return "unverifiable"

        if claim_years.intersection(metadata_years):
            return "potentially_supported"

        return "not_supported_by_metadata"

    # --------------------------------------------------
    # 4. Context claims
    # --------------------------------------------------
    if field == "context":

        metadata_text = " ".join(
            value for value in [
                keywords,
                description
            ]
            if value
        )

        if not metadata_text:
            return "not_metadata_checkable"

        claim_words = set(
            re.findall(r"\b[a-z]{4,}\b", claim)
        )

        metadata_words = set(
            re.findall(r"\b[a-z]{4,}\b", metadata_text)
        )

        overlap = claim_words.intersection(metadata_words)

        if overlap:
            return "potentially_supported"

        return "unverifiable"

    # --------------------------------------------------
    # 5. Other claims
    # --------------------------------------------------
    return "unverifiable"


claim_level_metadata["metadata_category"] = (
    claim_level_metadata.apply(
        assess_metadata,
        axis=1
    )
)

