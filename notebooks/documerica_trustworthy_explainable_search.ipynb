# Cell 42 — Calculate Image-Level Reliability Indicator

import pandas as pd
import numpy as np

# --------------------------------------------------
# Load image-level NLI consistency
# --------------------------------------------------

nli_summary = pd.read_csv(
    OUTPUT_DIR / "documerica_image_nli_summary.csv"
)

# --------------------------------------------------
# Load claim-level metadata validation
# --------------------------------------------------

metadata_df = pd.read_csv(
    OUTPUT_DIR / "documerica_claim_metadata_validation.csv"
)

# --------------------------------------------------
# Calculate metadata support for each image
# --------------------------------------------------

metadata_summary = (
    metadata_df
    .groupby("image_name")
    .agg(
        total_claims=("metadata_category", "size"),
        supported_claims=(
            "metadata_category",
            lambda x: (x == "potentially_supported").sum()
        ),
        unsupported_claims=(
            "metadata_category",
            lambda x: (x == "not_supported_by_metadata").sum()
        ),
        unverifiable_claims=(
            "metadata_category",
            lambda x: (x == "unverifiable").sum()
        ),
        not_checkable_claims=(
            "metadata_category",
            lambda x: (x == "not_metadata_checkable").sum()
        )
    )
    .reset_index()
)

# --------------------------------------------------
# Metadata support score
# --------------------------------------------------

metadata_summary["metadata_checkable_claims"] = (
    metadata_summary["supported_claims"] +
    metadata_summary["unsupported_claims"]
)

metadata_summary["metadata_support_score"] = np.where(
    metadata_summary["metadata_checkable_claims"] > 0,
    (
        metadata_summary["supported_claims"] /
        metadata_summary["metadata_checkable_claims"]
    ),
    np.nan
)

# --------------------------------------------------
# Merge NLI + metadata
# --------------------------------------------------

reliability_df = nli_summary.merge(
    metadata_summary,
    on="image_name",
    how="left"
)

# --------------------------------------------------
# Calculate final reliability score
# --------------------------------------------------
# 80% NLI consistency
# 20% metadata support
#
# If metadata is unavailable, do not penalize the score.
# In that case, use the NLI consistency directly.

reliability_df["reliability_score"] = np.where(
    reliability_df["metadata_support_score"].notna(),
    (
        0.80 * reliability_df["consistency_score"] +
        0.20 * reliability_df["metadata_support_score"]
    ) * 100,
    reliability_df["consistency_score"] * 100
)

# --------------------------------------------------
# Reliability categories
# --------------------------------------------------

def reliability_category(score):

    if score < 60:
        return "low"

    elif score < 80:
        return "moderate"

    else:
        return "high"


reliability_df["reliability_category"] = (
    reliability_df["reliability_score"]
    .apply(reliability_category)
)

# --------------------------------------------------
# Sort by reliability
# --------------------------------------------------

reliability_df = reliability_df.sort_values(
    "reliability_score"
).reset_index(drop=True)

# --------------------------------------------------
# Display results
# --------------------------------------------------

print("=" * 70)
print("IMAGE-LEVEL RELIABILITY INDICATOR")
print("=" * 70)

print("\nSummary statistics:")

display(
    reliability_df["reliability_score"]
    .describe()
)

print("\nReliability categories:")

category_counts = (
    reliability_df["reliability_category"]
    .value_counts()
    .reindex(["low", "moderate", "high"], fill_value=0)
)

display(
    category_counts.to_frame("count")
)

print("\nLowest-reliability images:")

display(
    reliability_df[
        [
            "image_name",
            "consistency_percent",
            "metadata_support_score",
            "reliability_score",
            "reliability_category"
        ]
