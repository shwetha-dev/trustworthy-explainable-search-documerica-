# Cell 24 — Claim-level clustering sensitivity analysis

from sklearn.metrics.pairwise import cosine_similarity
import numpy as np
import pandas as pd

CLUSTER_THRESHOLDS = [0.70, 0.75, 0.80]

cluster_sensitivity_results = []

for threshold in CLUSTER_THRESHOLDS:

    cluster_ids = []
    cluster_representatives = []

    # Process separately for each image
    for image_name, group in sentences_df.groupby("image_name"):

        indices = group.index.tolist()

        # Greedy clustering
        for idx in indices:

            vector = embeddings_normalized[idx]

            assigned_cluster = None

            for cluster_id, representative_idx in enumerate(
                cluster_representatives
            ):

                similarity = np.dot(
                    vector,
                    embeddings_normalized[representative_idx]
                )

                if similarity >= threshold:
                    assigned_cluster = cluster_id
                    break

            if assigned_cluster is None:
                cluster_representatives.append(idx)
                assigned_cluster = len(cluster_representatives) - 1

            cluster_ids.append({
                "image_name": image_name,
                "sentence_index": idx,
                "cluster_id": assigned_cluster
            })

    clusters_temp = pd.DataFrame(cluster_ids)

    # Make cluster IDs unique within each image
    clusters_temp["cluster_key"] = (
        clusters_temp["image_name"].astype(str)
        + "_"
        + clusters_temp["cluster_id"].astype(str)
    )

    cluster_sizes = (
        clusters_temp
        .groupby("cluster_key")
        .size()
    )

    cluster_sensitivity_results.append({
        "clustering_threshold": threshold,
        "total_clusters": cluster_sizes.shape[0],
        "mean_cluster_size": cluster_sizes.mean(),
        "median_cluster_size": cluster_sizes.median(),
        "max_cluster_size": cluster_sizes.max()
    })

claim_clustering_sensitivity_df = pd.DataFrame(
    cluster_sensitivity_results
)

print("Claim clustering sensitivity:")
display(claim_clustering_sensitivity_df)

# Save
CLUSTER_SENSITIVITY_PATH = os.path.join(
    OUTPUT_DIR,
    "claim_clustering_sensitivity.csv"
)

claim_clustering_sensitivity_df.to_csv(
    CLUSTER_SENSITIVITY_PATH,
    index=False
)

print("\n✓ Clustering sensitivity saved:")
print(CLUSTER_SENSITIVITY_PATH)


# Cell 25 — Create claim-level dataset using 0.75 threshold

CLAIM_THRESHOLD = 0.75

claim_records = []

for image_name, group in sentences_df.groupby("image_name"):

    indices = group.index.tolist()
    clusters = []

    for idx in indices:

        vector = embeddings_normalized[idx]
        assigned_cluster = None

        # Compare with existing cluster representatives
        for cluster_id, representative_idx in enumerate(clusters):

            similarity = np.dot(
                vector,
                embeddings_normalized[representative_idx]
            )

            if similarity >= CLAIM_THRESHOLD:
                assigned_cluster = cluster_id
                break

        # Create a new cluster if no match
        if assigned_cluster is None:
            clusters.append(idx)
            assigned_cluster = len(clusters) - 1

        row = sentences_df.loc[idx]

        claim_records.append({
            "image_name": image_name,
            "sentence_index": idx,
            "explanation_index": row["explanation_index"],
            "sentence_number": row["sentence_number"],
            "sentence": row["sentence"],
            "claim_cluster": assigned_cluster
        })

claim_level_df = pd.DataFrame(claim_records)

# Create globally unique cluster ID
claim_level_df["claim_id"] = (
    claim_level_df["image_name"].astype(str)
    + "_claim_"
