# Cell 10 — Generate eligible sentence pairs within each image

from itertools import combinations

pair_rows = []

for image_name, group in sentences_df.groupby("image_name"):

    records = group.to_dict("records")

    for a, b in combinations(records, 2):

        # Exclude sentences from the same explanation
        if a["explanation_index"] == b["explanation_index"]:
            continue

        pair_rows.append({
            "image_name": image_name,

            "source_explanation": a["explanation_index"],
            "source_sentence_number": a["sentence_number"],
            "source_sentence": a["sentence"],

            "target_explanation": b["explanation_index"],
            "target_sentence_number": b["sentence_number"],
            "target_sentence": b["sentence"]
        })

pairs_df = pd.DataFrame(pair_rows)

print("Total eligible sentence pairs:", len(pairs_df))
print("Unique images:", pairs_df["image_name"].nunique())

display(pairs_df.head())


# Cell 11 — Calculate cosine similarity for all eligible pairs

from sklearn.metrics.pairwise import cosine_similarity
import numpy as np

# Normalize embeddings first
embeddings_normalized = embeddings / np.linalg.norm(
    embeddings, axis=1, keepdims=True
)

# Map sentence dataframe row index to embedding
sentence_vectors = {
    idx: embeddings_normalized[idx]
    for idx in range(len(sentences_df))
}

similarities = []

for _, row in pairs_df.iterrows():

    # Find source and target sentence indices
    source_idx = (
        (sentences_df["image_name"] == row["image_name"]) &
        (sentences_df["explanation_index"] == row["source_explanation"]) &
        (sentences_df["sentence_number"] == row["source_sentence_number"])
    ).idxmax()

    target_idx = (
        (sentences_df["image_name"] == row["image_name"]) &
        (sentences_df["explanation_index"] == row["target_explanation"]) &
        (sentences_df["sentence_number"] == row["target_sentence_number"])
    ).idxmax()

    sim = np.dot(
        sentence_vectors[source_idx],
        sentence_vectors[target_idx]
    )

    similarities.append(sim)

pairs_df["similarity"] = similarities

print("Pairs:", len(pairs_df))
print("Mean similarity:", pairs_df["similarity"].mean())
print("Median similarity:", pairs_df["similarity"].median())
print("Minimum:", pairs_df["similarity"].min())
print("Maximum:", pairs_df["similarity"].max())

