# Cell 48 — Contradiction Summary for Case Studies

import pandas as pd
import numpy as np

# Count contradiction pairs for each selected image
contradiction_summary = (
    case_contradictions
    .groupby("image_name")
    .agg(
        contradiction_pairs=("nli_label", "size"),
        mean_similarity=("similarity", "mean"),
        mean_nli_score=("nli_score", "mean")
    )
    .reset_index()
)

# Add overall reliability information
case_reliability = reliability_df[
    reliability_df["image_name"].isin(selected_cases)
][
    [
        "image_name",
        "reliability_score",
        "reliability_category",
        "consistency_score",
        "contradiction_rate",
        "nli_pairs"
    ]
].copy()

case_summary = case_reliability.merge(
    contradiction_summary,
    on="image_name",
    how="left"
)

# Images with no contradictions will have NaN
case_summary["contradiction_pairs"] = (
    case_summary["contradiction_pairs"]
    .fillna(0)
    .astype(int)
)

case_summary = case_summary.sort_values(
    "reliability_score"
).reset_index(drop=True)

print("=" * 80)
print("CASE-STUDY SUMMARY")
print("=" * 80)

display(
    case_summary.round(3)
)

# Save
