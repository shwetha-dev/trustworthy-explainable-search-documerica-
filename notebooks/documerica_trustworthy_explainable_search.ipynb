# Cell 43 — Reliability Weight Sensitivity Analysis

from scipy.stats import spearmanr
import pandas as pd
import numpy as np

# Make sure the required columns exist
required_cols = [
    "image_name",
    "consistency_score",
    "metadata_support_score"
]

missing = [
    col for col in required_cols
    if col not in reliability_df.columns
]

if missing:
    raise ValueError(f"Missing columns: {missing}")

# --------------------------------------------------
# Weight combinations
# --------------------------------------------------

weight_settings = [
    (1.00, 0.00),
    (0.90, 0.10),
    (0.80, 0.20),
    (0.70, 0.30)
]

sensitivity_results = []

# Primary 80/20 ranking
primary_scores = reliability_df["reliability_score"].copy()

for nli_weight, metadata_weight in weight_settings:

    # Missing metadata = no metadata penalty.
    # Therefore, use NLI consistency when metadata
    # support cannot be calculated.

    scores = np.where(
        reliability_df["metadata_support_score"].notna(),
        (
            nli_weight * reliability_df["consistency_score"] +
            metadata_weight *
            reliability_df["metadata_support_score"]
        ) * 100,
        reliability_df["consistency_score"] * 100
    )

    # Correlation with primary 80/20 ranking
    rho, p_value = spearmanr(
        primary_scores,
        scores
    )

    sensitivity_results.append({
        "nli_weight": nli_weight,
        "metadata_weight": metadata_weight,
        "nli_percent": int(nli_weight * 100),
        "metadata_percent": int(metadata_weight * 100),
        "mean_score": np.mean(scores),
        "median_score": np.median(scores),
        "min_score": np.min(scores),
        "max_score": np.max(scores),
        "spearman_rho_vs_primary": rho,
        "p_value": p_value
    })

# --------------------------------------------------
# Create result table
# --------------------------------------------------

weight_sensitivity_df = pd.DataFrame(
    sensitivity_results
)

display(weight_sensitivity_df.round(4))

# --------------------------------------------------
# Save
# --------------------------------------------------

WEIGHT_SENSITIVITY_PATH = (
    OUTPUT_DIR /
    "reliability_weight_sensitivity.csv"
)

weight_sensitivity_df.to_csv(
    WEIGHT_SENSITIVITY_PATH,
    index=False
)

print("\n✓ Reliability weight sensitivity saved:")
print(WEIGHT_SENSITIVITY_PATH)


