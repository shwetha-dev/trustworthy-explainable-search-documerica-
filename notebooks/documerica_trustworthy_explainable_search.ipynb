# Cell 21 — Categorize images by contradiction rate

def contradiction_category(rate):
    percentage = rate * 100

    if percentage == 0:
        return "0%"
    elif percentage <= 5:
        return ">0–5%"
    elif percentage <= 10:
        return ">5–10%"
    elif percentage <= 20:
        return ">10–20%"
    else:
        return ">20%"


image_nli_summary["contradiction_category"] = (
    image_nli_summary["contradiction_rate"]
    .apply(contradiction_category)
)

category_order = [
    "0%",
    ">0–5%",
    ">5–10%",
    ">10–20%",
    ">20%"
]

category_counts = (
    image_nli_summary["contradiction_category"]
    .value_counts()
    .reindex(category_order, fill_value=0)
)

